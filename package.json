{
  "name": "web-portofolio",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "24.4.1",
    "npm": "11.4.2"
  },
  "packageManager": "npm@11.4.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "git config core.hooksPath .githooks || true; svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:artifact": "node scripts/verify-build-artifact.mjs",
    "quality": "npm run format:check && npm run lint && npm run check && npm run test:unit && npm run build && npm run test:artifact && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.13",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.20.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "drawably": "^0.3.10"
  }
}
